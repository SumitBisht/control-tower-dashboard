<diagram name="MongoDB - Production Supervision" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ps_reports" value="&lt;b&gt;ps_reports   (one per uploaded report; reportNo unique)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;_id,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&lt;br&gt;&amp;nbsp;&amp;nbsp;client{name},&amp;nbsp;spvName,&amp;nbsp;projectName,&lt;br&gt;&amp;nbsp;&amp;nbsp;manufacturer,&amp;nbsp;location,&amp;nbsp;workshop,&lt;br&gt;&amp;nbsp;&amp;nbsp;signatories[{role,designation,name}],&lt;br&gt;&amp;nbsp;&amp;nbsp;summary{&amp;nbsp;days,&amp;nbsp;firstDate,&amp;nbsp;lastDate,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;plannedQty,&amp;nbsp;actualQty,&amp;nbsp;actualMwp,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rejectedQty,&amp;nbsp;suspectedQty,&amp;nbsp;openNcs,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;bomItems,&amp;nbsp;bomDiffer,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ipqcChecks,&amp;nbsp;ipqcFail&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;uploadId,&amp;nbsp;createdAt&amp;nbsp;}&lt;br&gt;//&amp;nbsp;idx:&amp;nbsp;{&amp;nbsp;projectName:1,&amp;nbsp;reportDate:-1&amp;nbsp;}&lt;br&gt;//&amp;nbsp;NO&amp;nbsp;media,&amp;nbsp;NO&amp;nbsp;original&amp;nbsp;.docx&amp;nbsp;stored" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#fff8ec;strokeColor=#7a5c1e;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="430" height="330" as="geometry" /></mxCell><mxCell id="ps_production" value="&lt;b&gt;ps_production   (report x date x power bin)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&lt;br&gt;&amp;nbsp;&amp;nbsp;spvName,&amp;nbsp;projectName,&amp;nbsp;manufacturer,&lt;br&gt;&amp;nbsp;&amp;nbsp;date,&amp;nbsp;powerBin:&amp;nbsp;615,&lt;br&gt;&amp;nbsp;&amp;nbsp;planned:&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;actual:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;deviation:&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;day:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;night:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;}&amp;nbsp;}&lt;br&gt;//&amp;nbsp;reports&amp;nbsp;are&amp;nbsp;cumulative:&amp;nbsp;dashboards&amp;nbsp;keep&amp;nbsp;the&lt;br&gt;//&amp;nbsp;LATEST&amp;nbsp;report&amp;#x27;s&amp;nbsp;row&amp;nbsp;per&amp;nbsp;(projectName,date,bin)&lt;br&gt;//&amp;nbsp;idx:&amp;nbsp;{&amp;nbsp;projectName:1,&amp;nbsp;date:1,&amp;nbsp;powerBin:1&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#fff8ec;strokeColor=#7a5c1e;" vertex="1" parent="1"><mxGeometry x="520" y="40" width="470" height="300" as="geometry" /></mxCell><mxCell id="ps_qualification" value="&lt;b&gt;ps_qualification   (daily rows + &amp;#x27;cumulative&amp;#x27; row per report)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&amp;nbsp;spvName,&lt;br&gt;&amp;nbsp;&amp;nbsp;projectName,&amp;nbsp;manufacturer,&lt;br&gt;&amp;nbsp;&amp;nbsp;kind:&amp;nbsp;&amp;#x27;daily&amp;#x27;&amp;nbsp;|&amp;nbsp;&amp;#x27;cumulative&amp;#x27;,&amp;nbsp;date,&lt;br&gt;&amp;nbsp;&amp;nbsp;qualified:&amp;nbsp;{&amp;nbsp;&amp;#x27;610&amp;#x27;:&amp;nbsp;{qty,mwp},&amp;nbsp;&amp;#x27;615&amp;#x27;:&amp;nbsp;{qty,mwp}&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;moduleYtd,&amp;nbsp;rejected,&amp;nbsp;elReworkRejected,&lt;br&gt;&amp;nbsp;&amp;nbsp;suspected:&amp;nbsp;{&amp;nbsp;qty,&amp;nbsp;mwp&amp;nbsp;}&amp;nbsp;}&lt;br&gt;//&amp;nbsp;idx:&amp;nbsp;{&amp;nbsp;projectName:1,&amp;nbsp;kind:1,&amp;nbsp;date:1&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#fff8ec;strokeColor=#7a5c1e;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="470" height="290" as="geometry" /></mxCell><mxCell id="ps_nc" value="&lt;b&gt;ps_nc   (non-conformities)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&amp;nbsp;spvName,&lt;br&gt;&amp;nbsp;&amp;nbsp;projectName,&amp;nbsp;manufacturer,&lt;br&gt;&amp;nbsp;&amp;nbsp;key:&amp;nbsp;&amp;#x27;date|process|description&amp;#x27;,&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;same&amp;nbsp;NC&amp;nbsp;across&amp;nbsp;reports&lt;br&gt;&amp;nbsp;&amp;nbsp;date,&amp;nbsp;line,&amp;nbsp;description,&amp;nbsp;severity,&amp;nbsp;process,&lt;br&gt;&amp;nbsp;&amp;nbsp;affectedModules,&amp;nbsp;controlType,&amp;nbsp;vendorAction,&lt;br&gt;&amp;nbsp;&amp;nbsp;closureStatus,&amp;nbsp;status:&amp;nbsp;OPEN|CLOSED|UNKNOWN,&lt;br&gt;&amp;nbsp;&amp;nbsp;shift,&amp;nbsp;additionalDetails,&amp;nbsp;closedImmediately&amp;nbsp;}&lt;br&gt;//&amp;nbsp;idx:&amp;nbsp;{&amp;nbsp;projectName:1,&amp;nbsp;key:1&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#fff8ec;strokeColor=#7a5c1e;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="430" height="300" as="geometry" /></mxCell><mxCell id="ps_details" value="&lt;b&gt;ps_details   (one per report: detailed sections)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId&amp;nbsp;(unique),&amp;nbsp;reportNo,&amp;nbsp;...,&lt;br&gt;&amp;nbsp;&amp;nbsp;bom:&amp;nbsp;[&amp;nbsp;{&amp;nbsp;line,&amp;nbsp;shift,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;materials:&amp;nbsp;[{&amp;nbsp;material,&amp;nbsp;makeBom,&amp;nbsp;makeActual,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;originBom,&amp;nbsp;originActual,&amp;nbsp;batchNo,&amp;nbsp;result,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;remarks,&amp;nbsp;makeMatches,&amp;nbsp;originMatches&amp;nbsp;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;storage:&amp;nbsp;[{&amp;nbsp;material,&amp;nbsp;temperatureC,&amp;nbsp;humidityPct,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expiry,&amp;nbsp;observations,&amp;nbsp;result,&amp;nbsp;remarks&amp;nbsp;}]&amp;nbsp;}&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;ipqc:&amp;nbsp;[{&amp;nbsp;process,&amp;nbsp;check,&amp;nbsp;parameters,&amp;nbsp;qtyTested,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;testResult,&amp;nbsp;result,&amp;nbsp;line,&amp;nbsp;remarks&amp;nbsp;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;flasherVerification[],&amp;nbsp;flasherResults[],&lt;br&gt;&amp;nbsp;&amp;nbsp;soldering:&amp;nbsp;[{&amp;nbsp;line,&amp;nbsp;shift,&amp;nbsp;date,&amp;nbsp;front[7],&amp;nbsp;rear[7]&amp;nbsp;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;gel[],&amp;nbsp;gelOverall,&amp;nbsp;dimension[],&amp;nbsp;dimensionStandard,&lt;br&gt;&amp;nbsp;&amp;nbsp;dimensionOverall,&amp;nbsp;rfid[],&amp;nbsp;internalLab[],&lt;br&gt;&amp;nbsp;&amp;nbsp;finishedStorage[],&amp;nbsp;dataVerification[],&lt;br&gt;&amp;nbsp;&amp;nbsp;firstMeasurement[],&amp;nbsp;calibration{basic[],reference[]},&lt;br&gt;&amp;nbsp;&amp;nbsp;productionTotal{planned,actual,deviation,day,night},&lt;br&gt;&amp;nbsp;&amp;nbsp;quality:&amp;nbsp;[{&amp;nbsp;key,&amp;nbsp;label,&amp;nbsp;value,&amp;nbsp;status&amp;nbsp;}]&amp;nbsp;}&lt;br&gt;//&amp;nbsp;status:&amp;nbsp;OK&amp;nbsp;|&amp;nbsp;WARN&amp;nbsp;|&amp;nbsp;NOK&amp;nbsp;|&amp;nbsp;NA&amp;nbsp;&amp;nbsp;(dashboard&amp;nbsp;checks)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#f3fbf7;strokeColor=#2e7d6b;" vertex="1" parent="1"><mxGeometry x="1040" y="40" width="520" height="630" as="geometry" /></mxCell><mxCell id="e1" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="ps_production" target="ps_reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="ps_qualification" target="ps_reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="ps_nc" target="ps_reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="ps_details" target="ps_reports"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram name="MongoDB - Pre-Shipment Inspection" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="psi_reports" value="&lt;b&gt;psi_reports   (one per report = one per lot; reportNo unique)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;_id,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&lt;br&gt;&amp;nbsp;&amp;nbsp;client{name},&amp;nbsp;spvName,&amp;nbsp;projectName,&lt;br&gt;&amp;nbsp;&amp;nbsp;manufacturer,&amp;nbsp;location,&amp;nbsp;workshop,&lt;br&gt;&amp;nbsp;&amp;nbsp;signatories[{role,designation,name}],&lt;br&gt;&amp;nbsp;&amp;nbsp;lotNo,&amp;nbsp;lot{&amp;nbsp;lotNo,&amp;nbsp;factory,&amp;nbsp;sizePcs,&amp;nbsp;sizeMwp&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;wattClasses[{&amp;nbsp;wattClass,&amp;nbsp;modules,&amp;nbsp;mwp,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;productType,&amp;nbsp;remarks&amp;nbsp;}],&amp;nbsp;wattTotal,&lt;br&gt;&amp;nbsp;&amp;nbsp;conclusion:&amp;nbsp;&amp;#x27;PASS&amp;#x27;|&amp;#x27;FAIL&amp;#x27;,&lt;br&gt;&amp;nbsp;&amp;nbsp;summary{&amp;nbsp;tests,&amp;nbsp;testsPassed,&amp;nbsp;testsFailed,&amp;nbsp;ncTotal,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ncMajor,&amp;nbsp;ncMinor,&amp;nbsp;equipmentOverdue,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;powerOutOfTolerance,&amp;nbsp;avgDiffPct&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;uploadId,&amp;nbsp;createdAt&amp;nbsp;}&lt;br&gt;//&amp;nbsp;idx:&amp;nbsp;{&amp;nbsp;projectName:1,&amp;nbsp;lotNo:1,&amp;nbsp;reportDate:-1&amp;nbsp;}&lt;br&gt;//&amp;nbsp;latest&amp;nbsp;report&amp;nbsp;per&amp;nbsp;(project,&amp;nbsp;lot)&amp;nbsp;wins&amp;nbsp;on&amp;nbsp;dashboards&lt;br&gt;//&amp;nbsp;NO&amp;nbsp;media,&amp;nbsp;NO&amp;nbsp;original&amp;nbsp;.docx&amp;nbsp;stored" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#f5f0ff;strokeColor=#5b3d9a;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="450" height="360" as="geometry" /></mxCell><mxCell id="psi_results" value="&lt;b&gt;psi_results   (one per inspection/test row)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&amp;nbsp;spvName,&lt;br&gt;&amp;nbsp;&amp;nbsp;projectName,&amp;nbsp;manufacturer,&amp;nbsp;lotNo,&lt;br&gt;&amp;nbsp;&amp;nbsp;test,&amp;nbsp;standard,&amp;nbsp;aql,&amp;nbsp;sampling,&amp;nbsp;observation,&lt;br&gt;&amp;nbsp;&amp;nbsp;decision:&amp;nbsp;&amp;#x27;PASS&amp;#x27;|&amp;#x27;FAIL&amp;#x27;,&amp;nbsp;remarks&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#f5f0ff;strokeColor=#5b3d9a;" vertex="1" parent="1"><mxGeometry x="540" y="40" width="440" height="250" as="geometry" /></mxCell><mxCell id="psi_nc" value="&lt;b&gt;psi_nc   (non-conformities)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId,&amp;nbsp;reportNo,&amp;nbsp;reportDate,&amp;nbsp;spvName,&lt;br&gt;&amp;nbsp;&amp;nbsp;projectName,&amp;nbsp;manufacturer,&amp;nbsp;lotNo,&lt;br&gt;&amp;nbsp;&amp;nbsp;test,&amp;nbsp;category,&amp;nbsp;description,&amp;nbsp;risk,&amp;nbsp;count&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#f5f0ff;strokeColor=#5b3d9a;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="440" height="200" as="geometry" /></mxCell><mxCell id="psi_details" value="&lt;b&gt;psi_details   (one per report: detailed sections)&lt;/b&gt;&lt;br&gt;{&amp;nbsp;reportId&amp;nbsp;(unique),&amp;nbsp;reportNo,&amp;nbsp;lotNo,&amp;nbsp;...,&lt;br&gt;&amp;nbsp;&amp;nbsp;testConditions:&amp;nbsp;[{&amp;nbsp;test,&amp;nbsp;applicable,&amp;nbsp;process,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;manufacturer,&amp;nbsp;model,&amp;nbsp;serialNo,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;lastCalibration,&amp;nbsp;nextCalibration,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;observation,&amp;nbsp;evaluation&amp;nbsp;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;calibration:&amp;nbsp;[&amp;nbsp;sun-simulator&amp;nbsp;checks&amp;nbsp;before/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;during&amp;nbsp;PSI&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;maxPower:&amp;nbsp;{&amp;nbsp;rows:&amp;nbsp;[{&amp;nbsp;srNo,&amp;nbsp;moduleNo,&amp;nbsp;pmax,&amp;nbsp;vpm,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ipm,&amp;nbsp;ff,&amp;nbsp;pmax1,&amp;nbsp;vpm1,&amp;nbsp;ipm1,&amp;nbsp;ff1,&amp;nbsp;diffWp,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;diffPct,&amp;nbsp;dimension&amp;nbsp;}],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stats{&amp;nbsp;minimum,&amp;nbsp;maximum,&amp;nbsp;average&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;summary{&amp;nbsp;modules,&amp;nbsp;outOfTolerance,&amp;nbsp;avgPre,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;avgDuring,&amp;nbsp;avgDiffPct,&amp;nbsp;maxAbsDiffPct&amp;nbsp;}&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;ncSummary{&amp;nbsp;&amp;lt;test&amp;gt;:&amp;nbsp;[{&amp;nbsp;defect,&amp;nbsp;limitMajor,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;limitMinor,&amp;nbsp;observedMajor,&amp;nbsp;observedMinor,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;evaluation&amp;nbsp;}]&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;ncModules{&amp;nbsp;&amp;lt;test&amp;gt;:&amp;nbsp;[{&amp;nbsp;srNo,&amp;nbsp;serialNo,&amp;nbsp;defect&amp;nbsp;}]&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;insulation[],&amp;nbsp;wetLeakage[],&amp;nbsp;biFaciality[],&lt;br&gt;&amp;nbsp;&amp;nbsp;dynamicLoad[],&amp;nbsp;staticLoad[],&amp;nbsp;robustness[],&lt;br&gt;&amp;nbsp;&amp;nbsp;lowIrradiance[]&amp;nbsp;}" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Courier New;fontSize=11;fillColor=#f3fbf7;strokeColor=#2e7d6b;" vertex="1" parent="1"><mxGeometry x="1030" y="40" width="540" height="640" as="geometry" /></mxCell><mxCell id="f1" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="psi_results" target="psi_reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="psi_nc" target="psi_reports"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="reportId" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="psi_details" target="psi_reports"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
