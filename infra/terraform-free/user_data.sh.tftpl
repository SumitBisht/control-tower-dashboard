#!/bin/bash
# First-boot setup: swap, Docker + compose, and the app's config. The app code itself is copied by deploy.sh.
set -euxo pipefail
exec > >(tee /var/log/control-tower-bootstrap.log) 2>&1

# 2 GB swap: a 1 GB instance needs it for image builds and large report uploads
fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

dnf install -y docker tar gzip
systemctl enable --now docker
usermod -aG docker ec2-user
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP=/opt/control-tower
mkdir -p $APP/backend
chown -R ec2-user:ec2-user $APP

cat > $APP/.env <<'ENVEOF'
DOMAIN=${domain}
ENVEOF

cat > $APP/backend/.env <<'ENVEOF'
MONGODB_URI=${mongodb_uri}
MONGODB_DB=${db_name}
JWT_SECRET=${jwt_secret}
ADMIN_EMAIL=${admin_email}
ADMIN_PASSWORD=${admin_pass}
CLIENT_NAME=${client_name}
CORS_ORIGINS=["https://${domain}"]
ALLOW_SELF_REGISTRATION=true
STORAGE_BACKEND=s3
S3_BUCKET=${s3_bucket}
AWS_DEFAULT_REGION=${region}
MAX_UPLOAD_MB=250
PARSE_TIMEOUT_SECONDS=300
ENVEOF
chmod 600 $APP/.env $APP/backend/.env
chown ec2-user:ec2-user $APP/.env $APP/backend/.env
touch /var/lib/cloud/control-tower-ready
